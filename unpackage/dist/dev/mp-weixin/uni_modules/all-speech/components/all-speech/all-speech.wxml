<view><view class="record-btn" style="{{$root.s0}}" hover-class="record-btn-hover" hover-start-time="200" hover-stay-time="150" data-event-opts="{{[['longpress',[['startRecord',['$event']]]],['touchstart',[['touchStart',['$event']]]],['touchmove',[['touchMove',['$event']]]],['touchend',[['endRecord',['$event']]]]]}}" bindlongpress="__e" bindtouchstart="__e" bindtouchmove="__e" bindtouchend="__e">{{''+btnTextContent+''}}</view><view class="record-popup" style="{{'--popup-height:'+(popupHeight)+';'+('--popup-width:'+($root.m0)+';')+('--popup-bottom:'+($root.m1)+';')+('--popup-bg-color:'+(popupBgColor)+';')}}"><block wx:if="{{recordPopupShow}}"><view class="inner-content"><view class="title">{{popupTitle}}</view><block wx:if="{{recording}}"><view class="voice-line-wrap" style="{{'--line-height:'+($root.m2)+';'+('--line-start-color:'+(lineStartColor)+';')+('--line-end-color:'+(lineEndColor)+';')}}"><view class="voice-line one"></view><view class="voice-line two"></view><view class="voice-line three"></view><view class="voice-line four"></view><view class="voice-line five"></view><view class="voice-line six"></view><view class="voice-line seven"></view><view class="voice-line six"></view><view class="voice-line five"></view><view class="voice-line four"></view><view class="voice-line three"></view><view class="voice-line two"></view><view class="voice-line one"></view></view></block><block wx:if="{{!recording}}"><view class="cancel-icon">+</view></block><view class="tips">{{recording?popupDefaultTips:popupCancelTips}}</view></view></block></view></view>