<view class="container"><block wx:for="{{questions}}" wx:for-item="question" wx:for-index="index" wx:key="index"><view class="question-container"><view class="question-title">{{index+1+". "+question.title}}</view><radio-group value="{{question.answer}}" data-event-opts="{{[['change',[['saveResults',['$event',index]]]],['input',[['__set_model',['$0','answer','$event',[]],[[['questions','',index]]]]]]]}}" class="options-container" bindchange="__e" bindinput="__e"><block wx:for="{{question.options}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="optionIndex"><radio class="option" data-question-index="{{optionIndex}}" value="{{option}}">{{option}}</radio></block></radio-group></view></block><view class="save-button-container"><button data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" class="save-button" bindtap="__e">提交进行诊断</button></view></view>