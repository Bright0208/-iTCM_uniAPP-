<view class="container data-v-42f5f68d"><view class="row3 data-v-42f5f68d">{{"患者编号:"+patientIdcard}}</view><view class="image-container data-v-42f5f68d"><image class="img data-v-42f5f68d" src="{{imgUrl}}" mode="aspectFit" data-event-opts="{{[['tap',[['openPreview',['$event']]]]]}}" bindtap="__e"></image><block wx:if="{{done}}"><view class="label data-v-42f5f68d">已诊断</view></block></view><view class="flex-container2 data-v-42f5f68d"><view class="data-v-42f5f68d">整体(基色)</view><picker disabled="true" mode="selector" range="{{options}}" data-event-opts="{{[['change',[['onPickerChange',['$event']]]]]}}" bindchange="__e" class="data-v-42f5f68d"><view class="spaced-text2 data-v-42f5f68d">{{selectedOption}}</view></picker></view><view class="row2 data-v-42f5f68d"><view class="cell data-v-42f5f68d">颜色</view><view class="cell data-v-42f5f68d">颜色程度</view><view class="cell data-v-42f5f68d">症状程度</view></view><view class="container data-v-42f5f68d"><block wx:for="{{pickers}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block class="data-v-42f5f68d"><picker disabled="true" mode="multiSelector" data-index="{{index}}" value="{{item.index}}" range="{{ranges}}" data-event-opts="{{[['change',[['pick',['$event']]]]]}}" bindchange="__e" class="data-v-42f5f68d"><view class="flex-container data-v-42f5f68d"><view class="item data-v-42f5f68d">{{item.name}}</view><view class="spaced-text data-v-42f5f68d">{{item.selectedValue}}</view></view></picker></block></block></view><view class="row data-v-42f5f68d"><view class="remark_cell data-v-42f5f68d">备注：</view><input class="remark_input data-v-42f5f68d" disabled="true" type="text" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e"/></view><view class="button-container data-v-42f5f68d"><button data-event-opts="{{[['tap',[['previous',['$event']]]]]}}" class="half-width-button save-button data-v-42f5f68d" bindtap="__e">上一个</button><button data-event-opts="{{[['tap',[['next',['$event']]]]]}}" class="half-width-button next-button data-v-42f5f68d" bindtap="__e">下一个</button></view></view>