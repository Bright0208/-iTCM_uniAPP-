.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: white;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-bar .tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.tab-bar .tab-bar-item .tab_img {
  width: 37rpx;
  height: 41rpx;
}
.tab-bar .tab-bar-item .tab_text {
  font-size: 20rpx;
  margin-top: 9rpx;
}


.container {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
  height: 100%;
  padding: 20px;
  box-sizing: border-box;
  padding-bottom: 50px; /* 预留出tabBar的空间 */
}
.diagnosis-button {
  width: 80%; /* 按钮宽度 */
  padding: 15px 0; /* 垂直内边距 */
  font-size: 28px; /* 文字大小 */
  color: #fff; /* 文字颜色 */
  border: none; /* 去除边框 */
  border-radius: 25px; /* 边角圆滑 */
  background-color: #007AFF; /* 背景颜色 */
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* 盒阴影效果 */
  margin-bottom: 30px; /* 按钮间的间隔 */
}
.diagnosis-button:last-child {
  margin-bottom: 0; /* 最后一个按钮无底部间隔 */
}
.diagnosis-button:active {
  background-color: #0056b3; /* 激活时背景颜色 */
}

