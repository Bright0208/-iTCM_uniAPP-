<view class="container"><block wx:for="{{questions}}" wx:for-item="group" wx:for-index="i" wx:key="title"><view class="question-container"><view class="question-title">{{i+1+". "+group.title}}</view><checkbox-group value="{{group.values}}" data-event-opts="{{[['change',[['onCheckboxGroupChange',[i,'$event']]]],['input',[['__set_model',['$0','values','$event',[]],[[['questions','title',group.title]]]]]]]}}" class="options-container" bindchange="__e" bindinput="__e"><block wx:for="{{group.options}}" wx:for-item="item" wx:for-index="j" wx:key="j"><checkbox label="{{item}}" value="{{item}}">{{''+item+''}}</checkbox></block></checkbox-group></view></block><view class="save-button-container"><button data-event-opts="{{[['tap',[['save',['$event']]]]]}}" class="save-button" bindtap="__e">提交进行诊断</button></view></view>