<view class="container"><button class="avatar-container" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><image class="avatar" src="{{userInfo.avatarUrl}}"></image></button><view class="info-item"><text class="info-label">昵称：</text><input class="info-value" type="nickname" placeholder="请输入昵称" data-event-opts="{{[['blur',[['handleBlur',['$event']]]],['input',[['__set_model',['$0','nickname','$event',[]],['userInfo']],['onInputNickname',['$event']]]]]}}" value="{{userInfo.nickname}}" bindblur="__e" bindinput="__e"/></view><view class="info-item"><text class="info-label">姓名：</text><input class="info-value" type="text" placeholder="请输入姓名" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['userInfo']]]]]}}" value="{{userInfo.name}}" bindinput="__e"/></view><view class="info-item"><text class="info-label">性别：</text><picker class="info-picker" mode="selector" range="{{genderArray}}" value="{{userInfo.genderIndex}}" data-event-opts="{{[['change',[['onGenderChange',['$event']]]],['input',[['__set_model',['$0','genderIndex','$event',[]],['userInfo']]]]]}}" bindchange="__e" bindinput="__e"><view class="picker">{{''+genderArray[userInfo.genderIndex]+''}}</view></picker></view><view class="info-item"><text class="info-label">年龄：</text><input class="info-value" type="text" placeholder="请输入年龄" data-event-opts="{{[['input',[['__set_model',['$0','age','$event',[]],['userInfo']]]]]}}" value="{{userInfo.age}}" bindinput="__e"/></view><view class="info-item"><text class="info-label">手机：</text><input class="info-value" type="number" placeholder="请输入手机号" data-event-opts="{{[['blur',[['validatePhone',['$event']]]],['input',[['__set_model',['$0','phone','$event',[]],['userInfo']]]]]}}" value="{{userInfo.phone}}" bindblur="__e" bindinput="__e"/><text hidden="{{!(!phoneValid)}}" class="error-msg">格式有误</text></view><view class="info-item"><text class="info-label">密码：</text><input class="info-value" type="password" placeholder="密码" data-event-opts="{{[['blur',[['checkPassword',['$event']]]],['input',[['__set_model',['$0','password','$event',[]],['userInfo']]]]]}}" value="{{userInfo.password}}" bindblur="__e" bindinput="__e"/><block wx:if="{{passwordError}}"><text class="error-msg">{{passwordError}}</text></block></view><view class="info-item"><text class="info-label">确认密码：</text><input class="info-value" type="password" placeholder="确认密码" data-event-opts="{{[['blur',[['checkConfirmPassword',['$event']]]],['input',[['__set_model',['','confirmPassword','$event',[]]]]]]}}" value="{{confirmPassword}}" bindblur="__e" bindinput="__e"/><block wx:if="{{confirmPasswordError}}"><text class="error-msg">{{confirmPasswordError}}</text></block></view><view class="info-item"><text class="info-label">验证码：</text><input class="info-value" type="text" placeholder="验证码" data-event-opts="{{[['input',[['__set_model',['','captcha','$event',[]]]]]]}}" value="{{captcha}}" bindinput="__e"/><button class="info-button" disabled="{{disableButton}}" data-event-opts="{{[['tap',[['startCountDown',['$event']]]]]}}" bindtap="__e">{{disableButton?countDown+'s 后重新获取':'获取验证码'}}</button></view><view class="info-notice">除头像、昵称、性别、年龄之外，其余信息提交后不可修改，请认真填写</view><view class="agreements"><view class="checkbox-container"><checkbox value="{{isAgreementChecked}}" data-event-opts="{{[['tap',[['toggleAgreementCheck',['$event']]]],['input',[['__set_model',['','isAgreementChecked','$event',[]]]]]]}}" class="agreement-checkbox" bindtap="__e" bindinput="__e"></checkbox><text class="checkbox-label">我已阅读并同意</text></view><text data-event-opts="{{[['tap',[['openAgreement',['user']]]]]}}" class="agreement-link" bindtap="__e">《用户服务协议》</text><text>和</text><text data-event-opts="{{[['tap',[['openAgreement',['privacy']]]]]}}" class="agreement-link" bindtap="__e">《隐私政策》</text></view><button data-event-opts="{{[['tap',[['validateInfo',['$event']]]]]}}" class="submit-btn" bindtap="__e">提交</button></view>