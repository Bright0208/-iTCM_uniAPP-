
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
}
.avatar-container {
  border: none;
  outline: none;
  background-color: transparent;	  
  margin-bottom: 30px;
  border-radius: 50%;
}
.avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
}
.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
  width: 100%;
}
.info-label {
  width: 60px;
  color: #333;
}
.info-value, .info-picker {
  flex: 1;
  /* border: 1px solid #ddd; */
  padding: 10px;
  border-radius: 5px;
  background-color: #fff;
}
.info-button{
	flex: 1;
	font-size: 14px;
}
.picker-display {
  padding-left: 5px; /* 与输入框文字对齐 */
}
.error-msg {
  color: red;
  padding-left: 10px;
}
.submit-btn {
  width: 100%;
  padding: 10px 0;
  font-size: 16px;
  background-color: #000;
  color: #fff;
  border-radius: 5px;
  border: none;
  margin-top: 20px; /* 与其他元素分开 */
}
.info-notice {
  font-size: 12px; /* 设置小字号大小 */
  color: #999; /* 设置字体颜色 */
  text-align: center; /* 文字居中 */
  padding: 10px 0; /* 上下间距，左右不设置 */
  margin-top: 20px; /* 如有需要，可设置间距 */
}
.agreements {
  text-align: center;
  margin-top: 20px; /* 或更多，根据你页面的需求 */
  padding-bottom: 20px; /* 在这个元素的底部增加内边距以避免被tabbar遮挡 */
}
.agreement-link {
  color: #1E90FF; /* 或你应用的主题色 */
  margin: 0 5px;
  /* 如果希望实现点击时有视觉反馈，可以添加如下样式变量 */
  /* 注意这可能需要根据实际的框架或平台进行调整 */
  --active-color: #555;
  --active-opacity: 0.7;
}
.checkbox-container {
  display: flex;
  align-items: center;
}
.checkbox-label {
  margin-left: 8px;
}




