<view class="container"><view class="input-group"><text>手机：</text><uni-easyinput class="input" vue-id="0cd38814-1" trim="all" placeholder="手机号" value="{{phone}}" data-event-opts="{{[['^blur',[['checkPhone']]],['^input',[['__set_model',['','phone','$event',[]]]]]]}}" bind:blur="__e" bind:input="__e" bind:__l="__l"></uni-easyinput><block wx:if="{{phoneError}}"><text class="error-msg">{{phoneError}}</text></block></view><view class="input-group"><text>密码：</text><uni-easyinput class="input" vue-id="0cd38814-2" type="password" placeholder="密码" value="{{password}}" data-event-opts="{{[['^blur',[['checkPassword']]],['^input',[['__set_model',['','password','$event',[]]]]]]}}" bind:blur="__e" bind:input="__e" bind:__l="__l"></uni-easyinput><block wx:if="{{passwordError}}"><text class="error-msg">{{passwordError}}</text></block></view><view class="input-group"><text>密码：</text><uni-easyinput class="input" vue-id="0cd38814-3" type="password" placeholder="确认密码" value="{{confirmPassword}}" data-event-opts="{{[['^blur',[['checkConfirmPassword']]],['^input',[['__set_model',['','confirmPassword','$event',[]]]]]]}}" bind:blur="__e" bind:input="__e" bind:__l="__l"></uni-easyinput><block wx:if="{{confirmPasswordError}}"><text class="error-msg">{{confirmPasswordError}}</text></block></view><view class="input-group"><text>验证码：</text><uni-easyinput class="input" vue-id="0cd38814-4" placeholder="验证码" value="{{captcha}}" data-event-opts="{{[['^blur',[['checkCaptcha']]],['^input',[['__set_model',['','captcha','$event',[]]]]]]}}" bind:blur="__e" bind:input="__e" bind:__l="__l"></uni-easyinput><button class="info-button" disabled="{{disableButton}}" data-event-opts="{{[['tap',[['startCountDown',['$event']]]]]}}" bindtap="__e">{{disableButton?countDown+'s ':'获取验证码'}}</button></view><button data-event-opts="{{[['tap',[['register',['$event']]]]]}}" bindtap="__e">注册</button></view>