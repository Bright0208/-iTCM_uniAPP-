
.container {
  max-width: 400px;
  margin: 50px auto;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  background-color: #ffffff;
}
.form-group {
  margin-bottom: 15px;
}
.captcha-group {
   display: flex;       /* 使用flex布局 */
   align-items: center; /* 子项垂直居中 */
}
.captcha-container {
  display: flex;       /* 使用flex布局 */
  align-items: center; /* 子项垂直居中 */
}
.captcha-input {
  margin-right: 10px; /* 输入框和图片之间的间隔 */
}
.label {
  display: block;
  margin-bottom: 5px;
  font-size: 16px;
  color: #333333;
}
.input {

  font-size: 18px;
}
.input:focus {
  outline: none;
  border-color: #007BFF;
  box-shadow: 0 0 0 2px rgba(0,123,255,.25);
}
.captcha-btn {
  width: 400rpx;
  display: block;
  cursor: pointer;
  height: 80.4rpx;
}
.login-btn {
  width: 100%;
  padding: 10px;
  border: none;
  border-radius: 4px;
  background-color: #007BFF;
  color: white;
  font-size: 16px;
  cursor: pointer;
  outline: none;
}
.login-btn:hover {
  background-color: #0056b3;
}
.login-btn:active {
  background-color: #00408b;
}
.login-btn:focus {
  box-shadow: 0 0 0 2px rgba(0,123,255,.5);
}

