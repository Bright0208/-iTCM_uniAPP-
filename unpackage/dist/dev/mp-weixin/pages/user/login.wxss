
.page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  background: linear-gradient(135deg, #fdfcfb 0%, #e2d1c3 100%);
}
.logo-container {
  margin-top: 80px;
  margin-bottom: 80px;
  display: flex; /* 添加flex布局 */
  justify-content: center; /* 水平居中 */
  align-items: center; /* 垂直居中 */
  width: 100%; /* 确保容器宽度为100% */
}
.logo {
  width: 120px;
  height: 120px;
  /* 根据logo形状可能需要调整为 'width' 或 'height' */
  border-radius: 50%; /* 圆形logo的边框半径 */
}
.button-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 共同的样式 */
.button-common {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 80%;
  height: 50px; /* 设置一个固定高度 */
  margin-top: 20px; /* 确保按钮与按钮之间的间距相同 */
  margin-bottom: 20px;
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
  border-radius: 25px;
  text-align: center; /* 确保文本居中 */
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  transition: box-shadow 0.2s, -webkit-transform 0.2s;
  transition: transform 0.2s, box-shadow 0.2s;
  transition: transform 0.2s, box-shadow 0.2s, -webkit-transform 0.2s;
}

/* 应用于<button>的特定样式 */
.wxlogin-btn {
  background: #07C160; /* 微信绿 */
  border: none;
  outline: none;
}

/* 应用于<navigator>的特定样式 */
.login-btn {
  background: #ff5500; /* iOS 蓝 */
  border: 1px solid #ff5500; /* 有边框 */
  box-sizing: border-box; /* 确保边框宽度计算在内 */
  text-decoration: none; /* 移除超链接的下划线 */
}

/* 应用于<navigator>的特定样式 */
.register-btn {
  background: #007AFF; /* iOS 蓝 */
  border: 1px solid #007AFF; /* 有边框 */
  box-sizing: border-box; /* 确保边框宽度计算在内 */
  text-decoration: none; /* 移除超链接的下划线 */
}

/* 调整点击态 */
.button-common:active {
  -webkit-transform: translateY(2px);
          transform: translateY(2px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

