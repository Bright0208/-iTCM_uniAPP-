
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.icon-wrapper {
  width: 100px; /* 根据需要调整 */
  height: 100px; /* 根据需要调整 */
  border-radius: 50%; /* 设置为圆形 */
  overflow: hidden; /* 裁剪多余的部分 */
  margin: 20px 0; /* 根据需要调整外边距 */
}
.icon {
  width: 100%;
  height: 100%;
}
.title {
  font-size: 20px; /* 根据需要调整 */
  font-weight: bold; /* 加粗 */
  margin-bottom: 20px; /* 根据需要调整外边距 */
}
.information{
	font-size: 10px;
}
.content{
	padding: 20px;
}

