
























































































































/* 页面容器 */
.page-container {
  padding: 20rpx;
  background-color: #f8f8f8;
}
/* 头部区域样式 */
.header-section {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%; /* 圆形头像 */
  margin-right: 20rpx;
}
.nickname-and-arrow {
  display: flex;
  align-items: center;
  flex: 1;
}
.nickname-text {
  font-size: 32rpx;
  color: #333;
  flex: 1; /* 昵称占据剩余空间 */
}
.arrow-icon {
  font-size: 24rpx;
  color: #c0c0c0;
  padding: 10rpx; /* 箭头周围的空间 */
}
/* 望诊结果区域样式 */
.diagnosis-section {
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.diagnosis-title {
  font-size: 38rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.result-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.item-title {
  font-size: 34rpx;
  color: #666;
  min-width: 100rpx;
}
.item-desc {
  font-size: 34rpx;
  color: #666;
  flex: 1;
}
/* 问诊结果区域样式 */
.inquiry-section {
  background-color: #ffffff;
  padding: 20rpx;
}
.inquiry-title {
  font-size: 38rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.inquiry-content {
  font-size: 34rpx;
  color: #666;
}

