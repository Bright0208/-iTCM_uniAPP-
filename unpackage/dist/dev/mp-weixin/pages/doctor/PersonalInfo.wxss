/* 文章场景相关 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: white;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-bar .tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.tab-bar .tab-bar-item .tab_img {
  width: 37rpx;
  height: 41rpx;
}
.tab-bar .tab-bar-item .tab_text {
  font-size: 20rpx;
  margin-top: 9rpx;
}
















































































































/* 页面容器 */
.page-container {
  padding: 20rpx;
  background-color: #f8f8f8;
}
/* 头部区域样式 */
.header-section {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%; /* 圆形头像 */
  margin-right: 20rpx;
}
.nickname-and-arrow {
  display: flex;
  align-items: center;
  flex: 1;
}
.nickname-text {
  font-size: 32rpx;
  color: #333;
  flex: 1; /* 昵称占据剩余空间 */
}
/* 调整箭头样式，使其可重用 */
.arrow-icon {
  font-size: 24rpx;
  color: #c0c0c0;
  padding: 10rpx; /* 箭头周围的空间 */
  margin-left: auto; /* 使箭头靠右显示 */
}
/* 望诊结果区域样式 */
.diagnosis-section {
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.diagnosis-title {
  font-size: 38rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.result-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.item-title {
  font-size: 34rpx;
  color: #666;
  min-width: 100rpx;
}
.item-desc {
  font-size: 34rpx;
  color: #666;
  flex: 1;
}
/* 问诊结果区域样式 */
.inquiry-section {
  background-color: #ffffff;
  padding: 20rpx;
}
.inquiry-title {
  font-size: 38rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.inquiry-content {
  font-size: 34rpx;
  color: #666;
}

