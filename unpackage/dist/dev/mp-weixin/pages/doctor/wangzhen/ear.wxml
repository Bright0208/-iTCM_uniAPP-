<view class="container data-v-068c5428"><view class="row3 data-v-068c5428">{{"患者编号:"+patientId}}</view><view class="image data-v-068c5428"><image class="img data-v-068c5428" src="{{imgUrl}}" mode="aspectFit" data-event-opts="{{[['tap',[['openPreview',['$event']]]]]}}" bindtap="__e"></image></view><view class="flex-container2 data-v-068c5428"><view class="data-v-068c5428">整体(基色)</view><picker mode="selector" range="{{options}}" data-event-opts="{{[['change',[['onPickerChange',['$event']]]]]}}" bindchange="__e" class="data-v-068c5428"><view class="spaced-text2 data-v-068c5428">{{selectedOption}}</view></picker></view><view class="row2 data-v-068c5428"><view class="cell data-v-068c5428">颜色</view><view class="cell data-v-068c5428">颜色程度</view><view class="cell data-v-068c5428">症状程度</view></view><view class="container data-v-068c5428"><block wx:for="{{pickers}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block class="data-v-068c5428"><picker mode="multiSelector" data-index="{{index}}" value="{{item.index}}" range="{{ranges}}" data-event-opts="{{[['change',[['pick',['$event']]]]]}}" bindchange="__e" class="data-v-068c5428"><view class="flex-container data-v-068c5428"><view class="item data-v-068c5428">{{item.name}}</view><view class="spaced-text data-v-068c5428">{{item.selectedValue}}</view></view></picker></block></block></view><view class="row data-v-068c5428"><view class="remark_cell data-v-068c5428">备注：</view><input class="remark_input data-v-068c5428" type="text" placeholder="请输入备注" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e"/></view><view class="button-container data-v-068c5428"><button data-event-opts="{{[['tap',[['onSaveClick',['$event']]]]]}}" class="half-width-button save-button data-v-068c5428" bindtap="__e">保存</button><button data-event-opts="{{[['tap',[['onNextClick',['$event']]]]]}}" class="half-width-button next-button data-v-068c5428" bindtap="__e">下一页</button></view></view>