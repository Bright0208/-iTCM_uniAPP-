<view class="container"><view class="userinfo"><button class="avatar-wrapper" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><image class="avatar" src="{{avatarUrl}}"></image></button><input class="weui-input" type="nickname" placeholder="请输入昵称" data-event-opts="{{[['input',[['__set_model',['','nickname','$event',[]]],['onInputNickname',['$event']]]]]}}" value="{{nickname}}" bindinput="__e"/></view><button data-event-opts="{{[['tap',[['wechatLogin',['$event']]]]]}}" bindtap="__e">登录</button></view>