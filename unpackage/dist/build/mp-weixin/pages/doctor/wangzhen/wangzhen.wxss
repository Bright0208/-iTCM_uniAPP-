.tab-bar{position:fixed;bottom:0;left:0;right:0;height:100rpx;background:#fff;display:flex;justify-content:center;align-items:center;padding-bottom:env(safe-area-inset-bottom)}.tab-bar .tab-bar-item{flex:1;text-align:center;display:flex;justify-content:center;align-items:center;flex-direction:column}.tab-bar .tab-bar-item .tab_img{width:37rpx;height:41rpx}.tab-bar .tab-bar-item .tab_text{font-size:20rpx;margin-top:9rpx}.container{display:flex;flex-direction:column;justify-content:space-around;align-items:center;height:100%;padding:20px;box-sizing:border-box;padding-bottom:50px}.diagnosis-button{width:80%;padding:15px 0;font-size:28px;color:#fff;border:none;border-radius:25px;background-color:#007aff;box-shadow:0 4px 8px rgba(0,0,0,.1);margin-bottom:30px}.diagnosis-button:last-child{margin-bottom:0}.diagnosis-button:active{background-color:#0056b3}