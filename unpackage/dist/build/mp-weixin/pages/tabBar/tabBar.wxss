.tab-bar{position:fixed;bottom:0;left:0;right:0;height:100rpx;background:#fff;display:flex;justify-content:center;align-items:center;padding-bottom:env(safe-area-inset-bottom)}.tab-bar .tab-bar-item{flex:1;text-align:center;display:flex;justify-content:center;align-items:center;flex-direction:column}.tab-bar .tab-bar-item .tab_img{width:37rpx;height:41rpx}.tab-bar .tab-bar-item .tab_text{font-size:20rpx;margin-top:9rpx}