.tab-bar{position:fixed;bottom:0;left:0;right:0;height:100rpx;background:#fff;display:flex;justify-content:center;align-items:center;padding-bottom:env(safe-area-inset-bottom)}.tab-bar .tab-bar-item{flex:1;text-align:center;display:flex;justify-content:center;align-items:center;flex-direction:column}.tab-bar .tab-bar-item .tab_img{width:37rpx;height:41rpx}.tab-bar .tab-bar-item .tab_text{font-size:20rpx;margin-top:9rpx}.page-container{padding:20rpx;background-color:#f8f8f8}.header-section{display:flex;align-items:center;background-color:#fff;padding:20rpx;margin-bottom:20rpx}.user-avatar{width:80rpx;height:80rpx;border-radius:50%;margin-right:20rpx}.nickname-and-arrow{display:flex;align-items:center;flex:1}.nickname-text{font-size:32rpx;color:#333;flex:1}.arrow-icon{font-size:24rpx;color:silver;padding:10rpx}.diagnosis-section{background-color:#fff;padding:20rpx;margin-bottom:30rpx}.diagnosis-title{font-size:38rpx;color:#333;margin-bottom:10rpx}.result-item{display:flex;align-items:center;margin-bottom:10rpx}.item-title{font-size:34rpx;color:#666;min-width:100rpx}.item-desc{font-size:34rpx;color:#666;flex:1}.inquiry-section{background-color:#fff;padding:20rpx}.inquiry-title{font-size:38rpx;color:#333;margin-bottom:10rpx}.inquiry-content{font-size:34rpx;color:#666}