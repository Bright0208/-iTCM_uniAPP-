.page{display:flex;flex-direction:column;justify-content:center;align-items:center;height:100%;background:linear-gradient(135deg,#fdfcfb,#e2d1c3)}.logo-container{margin-top:80px;margin-bottom:80px;display:flex;justify-content:center;align-items:center;width:100%}.logo{width:120px;height:120px;border-radius:50%}.button-container{display:flex;flex-direction:column;align-items:center;width:100%}.button-common{display:flex;justify-content:center;align-items:center;width:80%;height:50px;margin-top:20px;margin-bottom:20px;color:#fff;font-size:18px;font-weight:700;border-radius:25px;text-align:center;box-shadow:0 5px 15px rgba(0,0,0,.2);transition:box-shadow .2s,-webkit-transform .2s;transition:transform .2s,box-shadow .2s;transition:transform .2s,box-shadow .2s,-webkit-transform .2s}.login-btn{background:#07c160;border:none;outline:none}.register-btn{background:#007aff;border:1px solid #007aff;box-sizing:border-box;text-decoration:none}.button-common:active{-webkit-transform:translateY(2px);transform:translateY(2px);box-shadow:0 2px 8px rgba(0,0,0,.2)}