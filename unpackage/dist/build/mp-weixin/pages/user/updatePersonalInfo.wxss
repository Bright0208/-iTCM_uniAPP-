.container{display:flex;flex-direction:column;align-items:center;padding:20px}.avatar-container{border:none;outline:none;background-color:initial;margin-bottom:30px;border-radius:50%}.avatar{width:100px;height:100px;border-radius:50%}.info-item{display:flex;align-items:center;margin-bottom:20px;width:100%}.info-label{width:60px;color:#333}.info-value, .info-picker{flex:1;padding:10px;border-radius:5px;background-color:#fff}.picker-display{padding-left:5px}.error-msg{color:red;padding-left:10px}.submit-btn{width:100%;padding:10px 0;font-size:16px;background-color:#000;color:#fff;border-radius:5px;border:none;margin-top:20px}.info-notice{font-size:12px;color:#999;text-align:center;padding:10px 0;margin-top:20px}