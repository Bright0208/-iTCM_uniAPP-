<view class="container"><button class="avatar-container" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><image class="avatar" src="{{userInfo.avatarUrl}}"></image></button><view class="info-item"><text class="info-label">昵称：</text><input class="info-value" type="nickname" placeholder="请输入昵称" data-event-opts="{{[['blur',[['handleBlur',['$event']]]],['input',[['__set_model',['$0','nickname','$event',[]],['userInfo']],['onInputNickname',['$event']]]]]}}" value="{{userInfo.nickname}}" bindblur="__e" bindinput="__e"/></view><view class="info-item"><text class="info-label">姓名：</text><text class="info-value">{{userInfo.name}}</text></view><view class="info-item"><text class="info-label">性别：</text><picker class="info-picker" mode="selector" range="{{genderArray}}" value="{{userInfo.genderIndex}}" data-event-opts="{{[['change',[['onGenderChange',['$event']]]],['input',[['__set_model',['$0','genderIndex','$event',[]],['userInfo']]]]]}}" bindchange="__e" bindinput="__e"><view class="picker">{{''+genderArray[userInfo.genderIndex]+''}}</view></picker></view><view class="info-item"><text class="info-label">年龄：</text><input class="info-value" type="text" placeholder="请输入年龄" data-event-opts="{{[['input',[['__set_model',['$0','age','$event',[]],['userInfo']]]]]}}" value="{{userInfo.age}}" bindinput="__e"/></view><view class="info-item"><text class="info-label">手机：</text><text class="info-value">{{userInfo.phone}}</text></view><view class="info-item"><text class="info-label">身份证：</text><text class="info-value">{{userInfo.idCard}}</text></view><button data-event-opts="{{[['tap',[['validateInfo',['$event']]]]]}}" class="submit-btn" bindtap="__e">提交</button></view>