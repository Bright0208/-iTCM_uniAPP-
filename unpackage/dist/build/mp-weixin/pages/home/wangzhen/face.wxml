<view class="container"><view class="upload-container"><button data-event-opts="{{[['tap',[['chooseAndUploadPhoto',['$event']]]]]}}" class="upload-btn" bindtap="__e">上传照片</button></view><block wx:if="{{uploadurl}}"><view class="text-section"><text class="image-text">你的照片</text></view></block><block wx:if="{{uploadurl}}"><view class="image-container"><image class="sample-image" src="{{uploadurl}}" mode="aspectFit" data-event-opts="{{[['tap',[['viewImage',['$0'],['uploadurl']]]]]}}" bindtap="__e"></image></view></block><view class="text-section"><text class="image-text">示例照片</text></view><view class="image-container"><image class="sample-image" src="{{imageSrc}}" mode="aspectFit" data-event-opts="{{[['tap',[['viewImage',['$0'],['imageSrc']]]]]}}" bindtap="__e"></image></view></view>