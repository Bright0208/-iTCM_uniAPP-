.tab-bar{position:fixed;bottom:0;left:0;right:0;height:100rpx;background:#fff;display:flex;justify-content:center;align-items:center;padding-bottom:env(safe-area-inset-bottom)}.tab-bar .tab-bar-item{flex:1;text-align:center;display:flex;justify-content:center;align-items:center;flex-direction:column}.tab-bar .tab-bar-item .tab_img{width:37rpx;height:41rpx}.tab-bar .tab-bar-item .tab_text{font-size:20rpx;margin-top:9rpx}.container{padding:20px}.question-container{margin-bottom:20px;background-color:#f9f9f9;border-radius:8px;padding:15px;box-shadow:0 2px 4px rgba(0,0,0,.1)}.question-title{font-weight:700;margin-bottom:10px;color:#333}.options-container{display:flex;flex-direction:column}.option{margin:5px 0;padding:10px;border-radius:5px;transition:background-color .3s}.option:hover{background-color:#e6e6e6}.save-button-container{display:flex;justify-content:center;margin-top:20px}.save-button{padding:10px 30px;color:#fff;background-color:#1a73e8;border:none;border-radius:4px;font-size:16px;cursor:pointer}.save-button:hover{background-color:#1669c7}